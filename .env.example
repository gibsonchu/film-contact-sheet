# Film Contact Sheet — environment
#
# Every variable here is OPTIONAL. With none of them set, the app runs fully
# local-first: sheets, photographs and annotations live in the browser's
# IndexedDB, export works, and accounts/cloud sharing are clearly labelled as
# unavailable rather than silently broken.

# ---------------------------------------------------------------- Supabase
# Enables accounts, cloud storage of sheets and share links that work on any
# device. Run supabase/migrations/*.sql against the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Email
# Enables the "send by email" flow in the share dialog (Resend).
# Without these the API route reports that email is not configured.
RESEND_API_KEY=
EMAIL_FROM="Film Contact Sheet <sheets@example.com>"

# --------------------------------------------------- Physical print & mail
# Ordering a printed postcard stays disabled unless BOTH are set and a
# PrintProvider implementation is registered in src/lib/print/provider.ts.
# No payment details are ever accepted or stored by this app.
PRINT_PROVIDER=
PRINT_PROVIDER_API_KEY=

# ------------------------------------------------------------------- Misc
# Used to build absolute share links in emails. Vercel sets this in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
